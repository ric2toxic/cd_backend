$(document).ready(function() {
    var val = '';
    var count = 1;
    $('#btnRight').click(function(e) {
        var selectedOpts = $('#lstBox1 option:selected');
        if (selectedOpts.length == 0) {
            alert("Nothing to move.");
            e.preventDefault();
        }
        for(var i=0;i<selectedOpts.length; i++){
          val += selectedOpts[i].value+",";
        }
        if(count == 1){
          var hidden_category = $('#hidden_filter').val();
          val = hidden_category + val;
        }
        count ++;
        $('#lstBox2').append($(selectedOpts).clone());
        $('#hidden_filter').val(val);
        $(selectedOpts).remove();
        e.preventDefault();
    });

    $('#btnLeft').click(function(e) {
        val = '';
        var selectedOpts = $('#lstBox2 option:selected');
        if (selectedOpts.length == 0) {
            alert("Nothing to move.");
            e.preventDefault();
        }
        var unselected_Opts = $('#lstBox2 option:not(:checked)');
        for(var i=0;i<unselected_Opts.length; i++){
          val += unselected_Opts[i].value+",";
        }
        $('#lstBox1').append($(selectedOpts).clone());
        $('#hidden_filter').val(val);
        $(selectedOpts).remove();
        e.preventDefault();
    });
